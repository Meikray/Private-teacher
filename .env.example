# Modèle du fichier .env (ce fichier-ci ne contient AUCUN vrai secret).
# Copie-le en « .env » (les lanceurs le font pour toi).

# ---------------------------------------------------------------------------
# Quelle IA joue le professeur ?
#   ollama    = GRATUIT : une IA installée sur ton ordinateur (https://ollama.com)
#   anthropic = Claude : plus performant, mais PAYANT (clé API nécessaire)
# ---------------------------------------------------------------------------
FOURNISSEUR=ollama

# Modèle local utilisé avec Ollama.
#   qwen2.5:7b  -> conseillé (environ 4,7 Go, 8 Go de mémoire vive)
#   qwen2.5:3b  -> pour un PC modeste (environ 2 Go)
MODELE_OLLAMA=qwen2.5:7b

# ---------------------------------------------------------------------------
# Seulement si FOURNISSEUR=anthropic : ta clé API Anthropic
# (console.anthropic.com, rubrique « API Keys »).
# Ne partage jamais ta clé et n'envoie jamais ce fichier sur GitHub.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=mets-ta-cle-ici
